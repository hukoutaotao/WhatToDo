{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:whattodo:task-fact-patch:0.1.0-task-fact-patch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command_id", "principal_id", "origin", "authority_ref", "target_ref", "fields"],
  "properties": {
    "schema_version": {"const": "0.1.0-task-fact-patch"},
    "command_id": {"$ref": "#/$defs/reference"},
    "principal_id": {"$ref": "#/$defs/reference"},
    "origin": {"const": "USER_COMMAND"},
    "authority_ref": {"$ref": "#/$defs/reference"},
    "target_ref": {
      "type": "object", "additionalProperties": false, "required": ["task_id", "revision"],
      "properties": {"task_id": {"$ref": "#/$defs/reference"}, "revision": {"type": "integer", "minimum": 1}}
    },
    "fields": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S"},
        "importance": {"$ref": "#/$defs/rating"},
        "difficulty": {
          "type": "object", "additionalProperties": false,
          "required": ["thinking_depth", "repetitive_volume", "new_learning_load"],
          "properties": {"thinking_depth": {"$ref": "#/$defs/rating"}, "repetitive_volume": {"$ref": "#/$defs/rating"}, "new_learning_load": {"$ref": "#/$defs/rating"}}
        },
        "requiredness": {"enum": ["REQUIRED", "OPTIONAL", "EXPIRING"]},
        "expiration_condition_ref": {"anyOf": [{"$ref": "#/$defs/reference"}, {"type": "null"}]},
        "user_remaining_seconds": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "deadline": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
            {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|[+-][0-9]{2}:[0-9]{2})$"}
          ]
        }
      }
    }
  },
  "$defs": {
    "reference": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S"},
    "rating": {"type": "integer", "minimum": 1, "maximum": 5}
  }
}
