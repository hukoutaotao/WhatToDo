{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:whattodo:review-queue-page:0.1.0-review-queue-page",
  "type": "object",
  "required": [
    "schema_version",
    "snapshot_id",
    "snapshot_hash",
    "observed_at",
    "expires_at",
    "store_revision",
    "target_minutes",
    "total_items",
    "start_index",
    "returned_count",
    "items",
    "groups",
    "next_cursor",
    "enumeration_complete",
    "coverage_blockers",
    "personal_reconciliation_complete"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0-review-queue-page"
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "snapshot_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "store_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "target_minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "total_items": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "start_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "returned_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "item_id",
          "kind",
          "source_ref",
          "reason",
          "title",
          "priority",
          "importance",
          "group_ref",
          "source_refs",
          "task_ref",
          "details",
          "answer",
          "requires_response"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "pattern": "^review-item-[a-f0-9]{64}$"
          },
          "kind": {
            "enum": [
              "TASK_ESTIMATE",
              "MANUAL_CREATION",
              "CLARIFICATION",
              "EVIDENCE_CANDIDATE",
              "EVIDENCE_CONFLICT",
              "GENERATION_PENDING",
              "GENERATION_FAILED",
              "STAGE_PENDING",
              "SOURCE_BLOCKER"
            ]
          },
          "source_ref": {
            "type": "object",
            "required": [
              "id",
              "revision"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9223372036854775807
              }
            },
            "additionalProperties": false
          },
          "reason": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
          },
          "title": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ]
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9
          },
          "importance": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              {
                "type": "null"
              }
            ]
          },
          "group_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "maxItems": 100,
            "uniqueItems": true
          },
          "task_ref": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "task_id",
                  "revision"
                ],
                "properties": {
                  "task_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9223372036854775807
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "details": {
            "type": "object"
          },
          "answer": {
            "const": null
          },
          "requires_response": {
            "type": "boolean"
          }
        },
        "allOf": [{
          "if": {"anyOf": [
            {"properties": {"kind": {"const": "SOURCE_BLOCKER"}}},
            {"properties": {"kind": {"const": "CLARIFICATION"}, "reason": {"const": "AWAITING_EXECUTION"}}}
          ]},
          "then": {"properties": {"requires_response": {"const": false}}},
          "else": {"properties": {"requires_response": {"const": true}}}
        }],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "group_ref",
          "item_count"
        ],
        "properties": {
          "group_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "item_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          }
        },
        "additionalProperties": false
      },
      "maxItems": 1000000
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        {
          "type": "null"
        }
      ]
    },
    "enumeration_complete": {
      "type": "boolean"
    },
    "coverage_blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
      },
      "uniqueItems": true
    },
    "personal_reconciliation_complete": {
      "const": false
    }
  },
  "additionalProperties": false
}
