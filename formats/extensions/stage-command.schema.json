{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:whattodo:stage-command:0.1.0-stage-command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command_id",
    "principal_id",
    "origin",
    "authority_ref",
    "target_ref",
    "operation",
    "fields"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0-stage-command"
    },
    "command_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?!\\s*$)[^\\u0000]+$"
    },
    "principal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?!\\s*$)[^\\u0000]+$"
    },
    "origin": {
      "const": "USER_COMMAND"
    },
    "authority_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?!\\s*$)[^\\u0000]+$"
    },
    "target_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "revision",
        "stage_id",
        "stage_revision"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^(?!\\s*$)[^\\u0000]+$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "stage_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^(?!\\s*$)[^\\u0000]+$"
        },
        "stage_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      }
    },
    "operation": {
      "enum": [
        "REWORK",
        "COMPLETE"
      ]
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "intent": {
          "enum": [
            "SAME_OBLIGATION",
            "CORRECTION",
            "NEW_OBLIGATION",
            "UNRESOLVED",
            null
          ]
        },
        "parent_remaining_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "stage_remaining_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  }
}
