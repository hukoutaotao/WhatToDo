{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:whattodo:review-queue-query:0.1.0-review-queue-query",
  "type": "object",
  "required": [
    "schema_version",
    "page_size",
    "target_minutes",
    "cursor"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0-review-queue-query"
    },
    "page_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "target_minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "cursor": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false
}
