{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:whattodo:resolution-intent:0.1.0-resolution-intent",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0-resolution-intent"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "command_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "principal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "action": {
      "enum": [
        "CREATE_TASK",
        "COMPLETE_TASK",
        "CANCEL_TASK",
        "UPDATE_TASK"
      ]
    },
    "target": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "ID",
                "NAME"
              ]
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "\\S"
            },
            "course": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "enum": [
                        "ID",
                        "NAME"
                      ]
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500,
                      "pattern": "\\S"
                    }
                  },
                  "required": [
                    "mode",
                    "value"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "mode",
            "value",
            "course"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "creation_task_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "fields": {
      "type": "object",
      "required": [],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "completion": {
          "enum": [
            "INCOMPLETE",
            "COMPLETE"
          ]
        },
        "disposition": {
          "enum": [
            "ACTIVE",
            "CANCELLED",
            "EXPIRED"
          ]
        },
        "requiredness": {
          "enum": [
            "REQUIRED",
            "OPTIONAL",
            "EXPIRING"
          ]
        },
        "importance": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "difficulty": {
          "type": "object",
          "required": [
            "thinking_depth",
            "repetitive_volume",
            "new_learning_load"
          ],
          "properties": {
            "thinking_depth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "repetitive_volume": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "new_learning_load": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            }
          },
          "additionalProperties": false
        },
        "user_remaining_seconds": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        },
        "expiration_condition_ref": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            }
          ]
        },
        "expiration_notice_ref": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            }
          ]
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    },
    "creation_facts": {
      "type": "object",
      "properties": {
        "domain": {
          "enum": [
            "study",
            "exercise",
            "life_administration",
            "other"
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "session_id",
    "command_id",
    "principal_id",
    "action",
    "target",
    "creation_task_id",
    "fields",
    "creation_facts"
  ],
  "additionalProperties": false
}
