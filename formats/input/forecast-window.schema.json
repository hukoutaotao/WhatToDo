{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:whattodo:forecast-window:0.1.0-draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_at",
    "timezone",
    "window_mode",
    "horizon_days",
    "start_date",
    "end_date",
    "cutoff"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0-draft"
    },
    "snapshot_at": {
      "type": "string",
      "format": "date-time"
    },
    "timezone": {
      "const": "Asia/Shanghai"
    },
    "window_mode": {
      "const": "NATURAL_DAY_INCLUDING_TODAY"
    },
    "horizon_days": {
      "enum": [
        1,
        3,
        7
      ]
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "cutoff": {
      "type": "string",
      "format": "date-time"
    }
  }
}
