{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:whattodo:goal-progress:0.1.0-draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "goal_id",
    "goal_revision",
    "observation_id",
    "observed_at",
    "source_ref",
    "reported",
    "completion"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0-draft"
    },
    "goal_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "goal_revision": {
      "type": "integer",
      "minimum": 1
    },
    "observation_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "reported": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "amount",
            "unit"
          ],
          "properties": {
            "amount": {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
            },
            "unit": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "completion": {
      "enum": [
        "INCOMPLETE",
        "COMPLETE"
      ]
    }
  }
}
