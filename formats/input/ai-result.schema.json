{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:whattodo:ai-result:0.1.0-draft",
  "title": "ai-result offline development contract",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0-draft"
    },
    "result_id": {
      "type": "string",
      "pattern": "\\S"
    },
    "job_id": {
      "type": "string",
      "pattern": "\\S"
    },
    "job_revision": {
      "type": "integer",
      "minimum": 1
    },
    "context_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "snapshot_ref": {
      "type": "string",
      "pattern": "\\S"
    },
    "output_contract_ref": {
      "type": "string",
      "pattern": "\\S"
    },
    "kind": {
      "enum": [
        "NUMERIC_REMAINING",
        "BEHAVIOR_PROPOSAL"
      ]
    },
    "executor_ref": {
      "type": "string",
      "pattern": "\\S"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "output_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "cost_amount": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "cost_amount",
        "currency"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "cost_amount": {
                "type": "string"
              }
            }
          },
          "then": {
            "properties": {
              "currency": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "result_id",
    "job_id",
    "job_revision",
    "context_hash",
    "snapshot_ref",
    "output_contract_ref",
    "kind",
    "executor_ref",
    "finished_at",
    "payload",
    "usage"
  ],
  "additionalProperties": false,
  "$defs": {
    "numeric": {
      "type": "object",
      "properties": {
        "quantity_kind": {
          "const": "REMAINING"
        },
        "task_id": {
          "type": "string",
          "pattern": "\\S"
        },
        "task_revision": {
          "type": "integer",
          "minimum": 1
        },
        "prediction_id": {
          "type": "string",
          "pattern": "\\S"
        },
        "model_id": {
          "type": "string",
          "pattern": "\\S"
        },
        "model_version": {
          "type": "string",
          "pattern": "\\S"
        },
        "remaining_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "computed_at": {
          "type": "string",
          "format": "date-time"
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        },
        "uncertainty_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "quantity_kind",
        "task_id",
        "task_revision",
        "prediction_id",
        "model_id",
        "model_version",
        "remaining_seconds",
        "computed_at",
        "valid_until",
        "uncertainty_ref"
      ],
      "additionalProperties": false
    },
    "behavior": {
      "type": "object",
      "properties": {
        "proposal_id": {
          "type": "string",
          "pattern": "\\S"
        },
        "target": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "TASK",
                "TASKTYPE",
                "PREFERENCE",
                "RELATIONSHIP_RULE"
              ]
            },
            "id": {
              "type": "string",
              "pattern": "\\S"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "kind",
            "id",
            "revision"
          ],
          "additionalProperties": false
        },
        "policy_kind": {
          "enum": [
            "PREFERENCE",
            "TASKTYPE_DEFAULT",
            "RELATIONSHIP_RULE",
            "DECOMPOSITION"
          ]
        },
        "description": {
          "type": "string",
          "pattern": "\\S"
        },
        "proposed_value": {
          "type": "object"
        },
        "confidence": {
          "type": "string",
          "pattern": "^(0(\\.[0-9]+)?|1(\\.0+)?)$"
        }
      },
      "required": [
        "proposal_id",
        "target",
        "policy_kind",
        "description",
        "proposed_value",
        "confidence"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "NUMERIC_REMAINING"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/numeric"
          }
        }
      },
      "else": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/behavior"
          }
        }
      }
    }
  ]
}

