{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:whattodo:candidate:0.1.0-draft",
  "title": "Pending source proposal development contract",
  "type": "object",
  "required": [
    "schema_version",
    "candidate_id",
    "source_ref",
    "parser_version",
    "action",
    "target_ref",
    "proposed_fields",
    "confidence",
    "created_at",
    "review"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0-draft"
    },
    "candidate_id": {
      "$ref": "#/$defs/reference"
    },
    "source_ref": {
      "type": "object",
      "required": [
        "source_id",
        "record_id",
        "content_hash"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/reference"
        },
        "record_id": {
          "$ref": "#/$defs/reference"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "parser_version": {
      "$ref": "#/$defs/reference"
    },
    "action": {
      "enum": [
        "CREATE_TASK",
        "UPDATE_TASK",
        "COMPLETE_TASK",
        "CANCEL_TASK"
      ]
    },
    "target_ref": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "task_id",
            "revision"
          ],
          "properties": {
            "task_id": {
              "$ref": "#/$defs/reference"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "proposed_fields": {
      "type": "object",
      "required": [],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "completion": {
          "enum": [
            "INCOMPLETE",
            "COMPLETE"
          ]
        },
        "disposition": {
          "enum": [
            "ACTIVE",
            "CANCELLED",
            "EXPIRED"
          ]
        },
        "requiredness": {
          "enum": [
            "REQUIRED",
            "OPTIONAL",
            "EXPIRING"
          ]
        },
        "importance": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "difficulty": {
          "type": "object",
          "required": [
            "thinking_depth",
            "repetitive_volume",
            "new_learning_load"
          ],
          "properties": {
            "thinking_depth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "repetitive_volume": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "new_learning_load": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            }
          },
          "additionalProperties": false
        },
        "remaining_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "deadline_text": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "review": {
      "type": "object",
      "required": [
        "state",
        "authority_ref",
        "reviewed_at",
        "canonical_task_id"
      ],
      "properties": {
        "state": {
          "enum": [
            "PENDING",
            "CONFLICTED",
            "CONFIRMED",
            "REJECTED"
          ]
        },
        "authority_ref": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/reference"
            }
          ]
        },
        "reviewed_at": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date-time",
              "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
            }
          ]
        },
        "canonical_task_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/reference"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "CREATE_TASK"
          }
        }
      },
      "then": {
        "properties": {
          "target_ref": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "COMPLETE_TASK"
          }
        }
      },
      "then": {
        "properties": {
          "proposed_fields": {
            "required": [
              "completion"
            ],
            "properties": {
              "completion": {
                "const": "COMPLETE"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "CANCEL_TASK"
          }
        }
      },
      "then": {
        "properties": {
          "proposed_fields": {
            "required": [
              "disposition"
            ],
            "properties": {
              "disposition": {
                "const": "CANCELLED"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review": {
            "properties": {
              "state": {
                "enum": [
                  "CONFIRMED",
                  "REJECTED"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "review": {
            "properties": {
              "authority_ref": {
                "$ref": "#/$defs/reference"
              },
              "reviewed_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "review": {
            "properties": {
              "authority_ref": {
                "type": "null"
              },
              "reviewed_at": {
                "type": "null"
              },
              "canonical_task_id": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review": {
            "properties": {
              "state": {
                "const": "CONFIRMED"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "review": {
            "properties": {
              "canonical_task_id": {
                "$ref": "#/$defs/reference"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "review": {
            "properties": {
              "canonical_task_id": {
                "type": "null"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    }
  }
}
