{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:whattodo:dispatch-result:0.1.0-draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "notice_id",
    "attempt"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0-draft"
    },
    "notice_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "attempt": {
      "allOf": [
        {
          "$ref": "#/$defs/attempt"
        },
        {
          "properties": {
            "state": {
              "enum": [
                "DELIVERED",
                "FAILED",
                "UNKNOWN"
              ]
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "started_at",
        "state",
        "finished_at",
        "delivered_at",
        "evidence_ref",
        "correlation_ref"
      ],
      "properties": {
        "attempt_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "state": {
          "enum": [
            "PENDING",
            "DELIVERED",
            "FAILED",
            "UNKNOWN"
          ]
        },
        "finished_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "delivered_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "correlation_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "PENDING"
              }
            }
          },
          "then": {
            "properties": {
              "finished_at": {
                "type": "null"
              },
              "delivered_at": {
                "type": "null"
              },
              "evidence_ref": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "finished_at": {
                "type": "string",
                "format": "date-time"
              },
              "evidence_ref": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "DELIVERED"
              }
            }
          },
          "then": {
            "properties": {
              "delivered_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "else": {
            "properties": {
              "delivered_at": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
