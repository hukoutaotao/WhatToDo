{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:whattodo:task-relation:0.1.0-draft",
  "title": "Concrete typed ordering or membership; no generation edge",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "relation_id",
    "revision",
    "kind",
    "before",
    "after",
    "authority_ref",
    "origin_rule_id",
    "origin_rule_version"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0-draft"
    },
    "relation_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "enum": [
        "COMPLETION_ORDER",
        "START_PREREQUISITE",
        "SOFT_SEQUENCE",
        "STAGE_MEMBERSHIP"
      ]
    },
    "before": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "TASK",
            "STAGE"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "after": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "TASK",
            "STAGE"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "authority_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "origin_rule_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "origin_rule_version": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "STAGE_MEMBERSHIP"
          }
        }
      },
      "then": {
        "properties": {
          "before": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "id"
            ],
            "properties": {
              "kind": {
                "const": "TASK"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          },
          "after": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "id"
            ],
            "properties": {
              "kind": {
                "const": "STAGE"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "origin_rule_id": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "origin_rule_version": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "origin_rule_version": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    }
  ]
}
