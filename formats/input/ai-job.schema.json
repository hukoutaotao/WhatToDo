{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:whattodo:ai-job:0.1.0-draft",
  "title": "ai-job offline development contract",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0-draft"
    },
    "job_id": {
      "type": "string",
      "pattern": "\\S"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "job_type": {
      "type": "string",
      "pattern": "\\S"
    },
    "executor_class": {
      "enum": [
        "DETERMINISTIC",
        "AUTOMATED",
        "MANUAL_PREMIUM"
      ]
    },
    "priority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "reason": {
      "type": "string",
      "pattern": "\\S"
    },
    "context_ref": {
      "type": "string",
      "pattern": "\\S"
    },
    "context_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "snapshot_ref": {
      "type": "string",
      "pattern": "\\S"
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "TASK",
              "TASKTYPE",
              "PREFERENCE",
              "RELATIONSHIP_RULE"
            ]
          },
          "id": {
            "type": "string",
            "pattern": "\\S"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "kind",
          "id",
          "revision"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "output_contract_ref": {
      "type": "string",
      "pattern": "\\S"
    },
    "expected_kind": {
      "enum": [
        "NUMERIC_REMAINING",
        "BEHAVIOR_PROPOSAL"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "PENDING",
        "EXPORTED",
        "RUNNING",
        "RESULT_RECEIVED",
        "VALIDATED",
        "REJECTED",
        "CANCELLED"
      ]
    },
    "exported_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "job_id",
    "revision",
    "job_type",
    "executor_class",
    "priority",
    "reason",
    "context_ref",
    "context_hash",
    "snapshot_ref",
    "targets",
    "output_contract_ref",
    "expected_kind",
    "created_at",
    "status",
    "exported_at"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "PENDING"
          }
        }
      },
      "then": {
        "properties": {
          "exported_at": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "EXPORTED"
          }
        }
      },
      "then": {
        "properties": {
          "exported_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  ]
}

