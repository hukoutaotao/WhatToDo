{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:whattodo:exam:0.1.0-draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "exam_id",
    "revision",
    "title",
    "course_ref",
    "acceptance",
    "acceptance_ref",
    "source_ref",
    "timing_kind",
    "exam_date",
    "interval",
    "coverage"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0-draft"
    },
    "exam_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "course_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "acceptance": {
      "enum": [
        "DRAFT",
        "ACCEPTED"
      ]
    },
    "acceptance_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "timing_kind": {
      "enum": [
        "UNKNOWN",
        "DATE_ONLY",
        "EXACT_EVENT"
      ]
    },
    "exam_date": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "interval": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "string",
              "format": "date-time"
            },
            "end": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "coverage": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "axis_ref",
            "axis_version",
            "start_unit_ref",
            "end_unit_ref"
          ],
          "properties": {
            "axis_ref": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "axis_version": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "start_unit_ref": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "end_unit_ref": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "acceptance": {
            "const": "ACCEPTED"
          }
        }
      },
      "then": {
        "properties": {
          "acceptance_ref": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "else": {
        "properties": {
          "acceptance_ref": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "timing_kind": {
            "const": "UNKNOWN"
          }
        }
      },
      "then": {
        "properties": {
          "exam_date": {
            "type": "null"
          },
          "interval": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "timing_kind": {
            "const": "DATE_ONLY"
          }
        }
      },
      "then": {
        "properties": {
          "exam_date": {
            "type": "string",
            "format": "date"
          },
          "interval": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "timing_kind": {
            "const": "EXACT_EVENT"
          }
        }
      },
      "then": {
        "properties": {
          "exam_date": {
            "type": "null"
          },
          "interval": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start",
              "end"
            ],
            "properties": {
              "start": {
                "type": "string",
                "format": "date-time"
              },
              "end": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    }
  ]
}
