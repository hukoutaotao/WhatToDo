{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:whattodo:calendar-event:0.1.0-draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "revision",
    "provider",
    "scope_ref",
    "external_id",
    "source_record_ref",
    "kind",
    "timing_kind",
    "interval",
    "occupancy",
    "state",
    "task_ref",
    "authority_ref"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0-draft"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "scope_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "external_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "source_record_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "kind": {
      "enum": [
        "EXTERNAL_FIXED",
        "PLANNED_WORK",
        "REMINDER"
      ]
    },
    "timing_kind": {
      "enum": [
        "TIMED",
        "ALL_DAY"
      ]
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "occupancy": {
      "enum": [
        "BLOCKING",
        "NON_BLOCKING",
        "UNKNOWN"
      ]
    },
    "state": {
      "enum": [
        "CONFIRMED",
        "TENTATIVE",
        "CANCELLED"
      ]
    },
    "task_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "authority_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "PLANNED_WORK"
          }
        }
      },
      "then": {
        "properties": {
          "task_ref": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "authority_ref": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    }
  ]
}
