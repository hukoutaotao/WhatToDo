{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:whattodo:effort:0.1.0-draft",
  "title": "Effort snapshot development contract",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "task_revision",
    "completion",
    "disposition",
    "user_remaining",
    "prediction",
    "stages"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0-draft"
    },
    "task_id": {
      "$ref": "#/$defs/reference"
    },
    "task_revision": {
      "type": "integer",
      "minimum": 1
    },
    "completion": {
      "enum": [
        "INCOMPLETE",
        "COMPLETE"
      ]
    },
    "disposition": {
      "enum": [
        "ACTIVE",
        "CANCELLED",
        "EXPIRED"
      ]
    },
    "user_remaining": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "seconds",
            "observation_id",
            "observed_at",
            "verified_at"
          ],
          "properties": {
            "seconds": {
              "type": "integer",
              "minimum": 0
            },
            "observation_id": {
              "$ref": "#/$defs/reference"
            },
            "observed_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            "verified_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "prediction": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "seconds",
            "prediction_id",
            "model_ref",
            "task_revision",
            "computed_at",
            "valid_until",
            "valid",
            "applicable"
          ],
          "properties": {
            "seconds": {
              "type": "integer",
              "minimum": 0
            },
            "prediction_id": {
              "$ref": "#/$defs/reference"
            },
            "model_ref": {
              "type": "object",
              "required": [
                "id",
                "version"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/reference"
                },
                "version": {
                  "$ref": "#/$defs/reference"
                }
              },
              "additionalProperties": false
            },
            "task_revision": {
              "type": "integer",
              "minimum": 1
            },
            "computed_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            "valid_until": {
              "type": "string",
              "format": "date-time",
              "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            "valid": {
              "type": "boolean"
            },
            "applicable": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stage_id",
          "completion",
          "weight",
          "user_remaining"
        ],
        "properties": {
          "stage_id": {
            "$ref": "#/$defs/reference"
          },
          "completion": {
            "enum": [
              "INCOMPLETE",
              "COMPLETE"
            ]
          },
          "weight": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "user_remaining": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "seconds",
                  "observation_id",
                  "observed_at",
                  "verified_at"
                ],
                "properties": {
                  "seconds": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "observation_id": {
                    "$ref": "#/$defs/reference"
                  },
                  "observed_at": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
                  },
                  "verified_at": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "completion": {
            "const": "COMPLETE"
          }
        }
      },
      "then": {
        "properties": {
          "user_remaining": {
            "type": "object",
            "properties": {
              "seconds": {
                "const": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "EXPIRED"
          }
        }
      },
      "then": {
        "properties": {
          "completion": {
            "const": "INCOMPLETE"
          }
        }
      }
    }
  ],
  "$defs": {
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    }
  }
}
