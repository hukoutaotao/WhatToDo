{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:whattodo:today-lock:0.1.0-draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lock_id",
    "task_id",
    "task_revision",
    "intent",
    "authority_ref",
    "created_at",
    "expires_at",
    "timezone"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0-draft"
    },
    "lock_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "task_revision": {
      "type": "integer",
      "minimum": 1
    },
    "intent": {
      "enum": [
        "COMPLETE",
        "ADVANCE"
      ]
    },
    "authority_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "timezone": {
      "const": "Asia/Shanghai"
    }
  }
}
