{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:whattodo:review-response:0.1.0-draft",
  "title": "Partial/full review response development contract",
  "type": "object",
  "required": [
    "schema_version",
    "review_id",
    "frame_revision",
    "submitted",
    "user_statement_ref",
    "task_answers",
    "batches",
    "candidate_answers"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0-draft"
    },
    "review_id": {
      "$ref": "#/$defs/reference"
    },
    "frame_revision": {
      "type": "integer",
      "minimum": 1
    },
    "submitted": {
      "type": "boolean"
    },
    "user_statement_ref": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/reference"
        }
      ]
    },
    "task_answers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "expected_revision",
          "completion",
          "worked_on",
          "remaining_seconds",
          "actual_report"
        ],
        "properties": {
          "task_id": {
            "$ref": "#/$defs/reference"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 1
          },
          "completion": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "enum": [
                  "COMPLETE",
                  "INCOMPLETE"
                ]
              }
            ]
          },
          "worked_on": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "remaining_seconds": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ]
          },
          "actual_report": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "seconds",
                  "measure"
                ],
                "properties": {
                  "seconds": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "measure": {
                    "enum": [
                      "INCREMENT",
                      "CUMULATIVE"
                    ]
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "batches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "batch_id",
          "confirmed",
          "members",
          "confirm_existing_completion",
          "no_work_statement"
        ],
        "properties": {
          "batch_id": {
            "$ref": "#/$defs/reference"
          },
          "confirmed": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "members": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "task_id",
                "expected_revision",
                "observation_id",
                "seconds"
              ],
              "properties": {
                "task_id": {
                  "$ref": "#/$defs/reference"
                },
                "expected_revision": {
                  "type": "integer",
                  "minimum": 1
                },
                "observation_id": {
                  "$ref": "#/$defs/reference"
                },
                "seconds": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "confirm_existing_completion": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "no_work_statement": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "boolean"
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "candidate_answers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "resolution"
        ],
        "properties": {
          "candidate_id": {
            "$ref": "#/$defs/reference"
          },
          "resolution": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "enum": [
                  "CONFIRMED",
                  "REJECTED"
                ]
              }
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "submitted": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "user_statement_ref": {
            "$ref": "#/$defs/reference"
          }
        }
      },
      "else": {
        "properties": {
          "user_statement_ref": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    }
  }
}
