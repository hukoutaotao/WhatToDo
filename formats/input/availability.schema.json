{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:whattodo:availability:0.1.0-draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_ref",
    "snapshot_at",
    "cutoff",
    "availability",
    "occupancy",
    "data_quality",
    "unresolved_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0-draft"
    },
    "snapshot_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "snapshot_at": {
      "type": "string",
      "format": "date-time"
    },
    "cutoff": {
      "type": "string",
      "format": "date-time"
    },
    "availability": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start",
          "end"
        ],
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "occupancy": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start",
          "end"
        ],
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "data_quality": {
      "enum": [
        "READY",
        "UNRESOLVED",
        "STALE"
      ]
    },
    "unresolved_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "data_quality": {
            "const": "READY"
          }
        }
      },
      "then": {
        "properties": {
          "unresolved_refs": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "unresolved_refs": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
